# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
coverage/
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local-only files
*.local

# IDEs
.vscode/*
!.vscode/extensions.json
.idea/

# OS files
.DS_Store
Thumbs.db

# Vercel
.vercel/

# Python
__pycache__/
*.pyc

# EDGEiQ local archives / old checkpoints
_archive_pre_git_commit/
_archive/
CHECKPOINTS/
*_CHECKPOINT*
*_BACKUP*
*_WORKING*
src_backup*/
src_BROKEN_BACKUP/
*.zip
*.png

# EDGEiQ task work, diagnostics and recovery material
work/
backups/
EDGEIQ_PERFORMANCE_REPAIR_PACK/
repository_inventory.csv
EDGEIQ_FILE_INDEX.txt

# Large local/generated data warehouses - never add as new Git objects
public/data/
*.parquet
*.db
*.sqlite
*.xlsx
*.csv.gz
*.json.gz

# Performance-intelligence generated/research warehouses
docs/performance-intelligence/warehouse/
docs/performance-intelligence/warehouse-v2/
docs/performance-intelligence/prototypes/
docs/**/archive/
docs/**/rollback/

# Generated publication/data products that belong to runtime storage, not source history
public/performance-intelligence/

# Temporary / accidental copies
*.bak
*.tmp
*.temp
*.pre_*
*BEFORE_*
*_OLD*
*_COPY*

# Keep source/config/docs lightweight and intentional. Existing tracked files remain tracked;
# these rules prevent future generated bulk from being added accidentally.
