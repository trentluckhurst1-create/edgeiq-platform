{
  "contract_name": "edgeiq_benchmark_accumulation_fact_v1",
  "contract_version": "1.0.0",
  "grain": "one_row_per_benchmark_group",
  "grouping_basis": "TRACK_DISTANCE",
  "minimum_required_sample": 20,
  "primary_key": ["benchmark_group_id"],
  "required_fields": [
    "benchmark_group_id",
    "benchmark_group_basis",
    "track_name",
    "official_distance_metres",
    "course_name",
    "course_name_status",
    "surface",
    "surface_status",
    "track_condition",
    "track_condition_status",
    "eligible_observation_count",
    "minimum_required_sample",
    "benchmark_ready",
    "accumulation_status",
    "group_dimension_sha256",
    "membership_sha256",
    "source_eligibility_rule_version",
    "source_observation_canonical_version",
    "builder_version",
    "contract_version",
    "built_at_utc"
  ],
  "allowed_values": {
    "benchmark_group_basis": ["TRACK_DISTANCE"],
    "course_name_status": ["NOT_AVAILABLE_IN_SOURCE"],
    "surface_status": ["NOT_AVAILABLE_IN_SOURCE"],
    "track_condition_status": ["NOT_AVAILABLE_IN_SOURCE"],
    "benchmark_ready": ["true", "false"],
    "accumulation_status": ["READY", "INSUFFICIENT_SAMPLE"]
  },
  "forbidden_statistical_fields": [
    "average",
    "mean",
    "median",
    "percentile",
    "variance",
    "regression",
    "weight",
    "interpolation",
    "smoothing",
    "benchmark_time",
    "standard_time",
    "track_variant",
    "lengths_vs_standard",
    "performance_rating",
    "speed_rating",
    "epi"
  ]
}
