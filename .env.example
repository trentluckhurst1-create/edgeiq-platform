# Optional Clerk authentication. Leave blank to run without Clerk.
VITE_CLERK_PUBLISHABLE_KEY=

# Development-only auth bypass. Only honoured by the app in Vite DEV mode.
VITE_DISABLE_AUTH=false

# Production EDGEiQ governed data origin.
# Example: https://data.example.com
# Leave blank for same-origin /data/... paths during local development.
VITE_EDGEIQ_DATA_ORIGIN=
