# Optional Clerk authentication. Leave blank to run without Clerk.
VITE_CLERK_PUBLISHABLE_KEY=

# Development-only auth bypass. Only honoured by the app in Vite DEV mode.
VITE_DISABLE_AUTH=false

# EDGEiQ production is served from GitHub Pages.
# Keep production frontend data under public/data/ so it is bundled into the Pages artifact.
# Do not configure an external production data origin unless the architecture is explicitly changed later.
