  "probability_formula": {
    "source": "HistGradientBoostingClassifier.decision_function(X_i)",
    "formula": "p_i = exp(z_i - max_r(z)) / sum_j exp(z_j - max_r(z)) within each race r",
    "mass_tolerance": 1e-12,
    "forbidden": "Never normalize predict_proba directly."
