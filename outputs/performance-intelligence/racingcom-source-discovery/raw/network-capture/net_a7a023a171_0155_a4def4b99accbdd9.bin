// auth0 redirection via the /plus route
window.redirectToAuth0 = window.redirectToAuth0 || function () {
    window.location.href = '/plus?ref=' + window.location.pathname;
};

window.customGetCookie = function (name) {
    var i, x, y, ARRcookies = document.cookie.split(";");
    for (i = 0; i < ARRcookies.length; i++) {
        x = ARRcookies[i].substr(0, ARRcookies[i].indexOf("="));
        y = ARRcookies[i].substr(ARRcookies[i].indexOf("=") + 1);
        x = x.replace(/^\s+|\s+$/g, "");
        if (x == name) {
            return decodeURI(y);
        }
    }
    return null;
};

window.customRemoveCookie = function (name) {
    document.cookie = name + '=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
};

// auth0 + r+ 2.0 first login event
window.trackGAFirstLogin = window.trackGAFirstLogin || function () {
	if (!window.gtag && typeof window.trackGAFirstLogin === 'function') {
		setTimeout(function() {
			window.trackGAFirstLogin();
		}, 500);
	} else {
		try {
			var rvfirstlogin = window.customGetCookie('rvfirstlogin');
			if (rvfirstlogin && window.trackCustomAction) {
				window.customRemoveCookie('rvfirstlogin');
				window.trackCustomAction('R+ 2.0', 'Auth0_login', window.href, 'First_login');
			}
		} catch (err) {
			console.log('RV.Helper.Cookie: ', err);
		}
	}
};

window.document.addEventListener("DOMContentLoaded", function() {
    window.trackGAFirstLogin && window.trackGAFirstLogin();
});

